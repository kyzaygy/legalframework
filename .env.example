# Скопируйте в .env и задайте стойкий POSTGRES_PASSWORD (URL-безопасный, без / + = : @).
# Сгенерировать: openssl rand -hex 24
# .env в репозиторий не коммитится.
POSTGRES_USER="kodeksy"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="kodeksy"

SITE_URL="https://legalframework.ru"

# Секрет для сброса кэша контента после импорта (POST /api/revalidate).
# Сгенерировать: openssl rand -hex 24. Пусто — эндпоинт отключён,
# кэш обновится сам в течение суток.
REVALIDATE_SECRET=""

PRAVO_CODEX_URL="http://pravo.gov.ru/codex/"
PRAVO_CONSTITUTION_URL="http://pravo.gov.ru/constitution/"
PRAVO_API_BASE="http://actual.pravo.gov.ru:8000/api/ebpi/"
PRAVO_BPA="ebpi"
