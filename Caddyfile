legalframework.ru {
	encode zstd gzip

	header {
		# HSTS: год, включая поддомены
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		# Не раскрывать сервер
		-Server
		defer
	}

	# CSP выставляется приложением (src/middleware.ts): политика с per-request
	# nonce, который Next подставляет в свои инлайновые скрипты — из Caddy так
	# не сделать. Сейчас режим Report-Only; после периода наблюдения
	# переключается флагом CSP_ENFORCE в middleware.

	reverse_proxy app:3000
}

www.legalframework.ru {
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	redir https://legalframework.ru{uri} permanent
}
